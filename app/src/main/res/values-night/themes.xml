<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KX.Base" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kx_night_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.KX.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kx_night_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_kx_brand_orb</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.KX</item>
    </style>
</resources>
